# Copy to .env.local: cp .env.example .env.local

# --- Local development ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_KEY=dev-secret-key
NEXT_PUBLIC_API_KEY=dev-secret-key

# --- Production (Vercel dashboard — apps/frontend) ---
# api.polkaudit.xyz is a Cloud Run custom domain (not a Vercel rewrite).
# Use it for both browser and SSR — do not set INTERNAL_API_URL.
#
#   NEXT_PUBLIC_API_URL=https://api.polkaudit.xyz/api/v1
#   API_KEY=<same as Secret Manager polkaudit-api-key>
#   NEXT_PUBLIC_API_KEY=<same as API_KEY>
#
# Unset INTERNAL_API_URL in Vercel if it still points at an old *.run.app URL.
