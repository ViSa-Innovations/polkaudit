# Copy to .env.local: cp .env.example .env.local

# --- Local development ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_KEY=dev-secret-key
NEXT_PUBLIC_API_KEY=dev-secret-key

# --- Production (Vercel dashboard — apps/frontend) ---
# Browser/client API traffic (via api.polkaudit.xyz Vercel rewrite):
#   NEXT_PUBLIC_API_URL=https://api.polkaudit.xyz/api/v1
# Server-side/SSR (direct to Cloud Run, avoids double-hop):
#   INTERNAL_API_URL=https://polkaudit-backend-4705238576.asia-south1.run.app/api/v1
# Do not set INTERNAL_API_URL locally unless testing SSR against Cloud Run.
